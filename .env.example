# ExcelMind AI - Configuracao de Provedores de IA
# Copie este arquivo para .env e preencha suas chaves de API

# ============================================
# PROVEDOR PRINCIPAL: Google Gemini (recomendado)
# Modelos disponiveis: gemini-2.5-flash, gemini-2.5-flash-lite
# Obtenha sua chave em: https://ai.google.dev/
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# PROVEDOR ALTERNATIVO 1: OpenAI
# Modelos disponiveis: gpt-4o-mini, gpt-4o
# Obtenha sua chave em: https://platform.openai.com/
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ============================================
# PROVEDOR ALTERNATIVO 2: Anthropic Claude
# Modelos disponiveis: claude-3-haiku, claude-3-sonnet
# Obtenha sua chave em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ============================================
# CONFIGURACAO DO PROVEDOR
# Valores: "gemini" (padrao), "openai", "anthropic"
# Se nao definido, usa Gemini automaticamente se GEMINI_API_KEY existir
LLM_PROVIDER=gemini

# ============================================
# CONFIGURACOES GERAIS
TEMPERATURE=0.2
DEBUG=false
LOG_LEVEL=INFO